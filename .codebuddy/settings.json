{
  "permissions": {
    "defaultMode": "acceptEdits",

    "_match_note": "重要：Bash() 规则是对**整条命令字符串**的前缀匹配，不是按命令名解析。例如命令 'cd d:\\foo; rm x.txt' 必须有规则 'Bash(cd d:\\foo;*)' 或 'Bash(cd:*)' 才能匹配（cd 是字串首词）。复合命令（用 ; / && 串联）只看首词。所以下面的规则按"首词"组织。",

    "allow": [
      "Bash(cd:*)",
      "Bash(pwd:*)",

      "Bash(Remove-Item:*)",
      "Bash(Move-Item:*)",
      "Bash(Copy-Item:*)",
      "Bash(New-Item:*)",
      "Bash(Rename-Item:*)",
      "Bash(Get-Item:*)",
      "Bash(Get-ChildItem:*)",
      "Bash(Get-Content:*)",
      "Bash(Set-Content:*)",
      "Bash(Add-Content:*)",
      "Bash(Out-File:*)",
      "Bash(Test-Path:*)",
      "Bash(Resolve-Path:*)",
      "Bash(Select-String:*)",
      "Bash(Where-Object:*)",
      "Bash(Select-Object:*)",
      "Bash(Sort-Object:*)",
      "Bash(ForEach-Object:*)",
      "Bash(Measure-Object:*)",
      "Bash(Format-Table:*)",
      "Bash(Format-List:*)",
      "Bash(Out-Null:*)",
      "Bash(Out-String:*)",
      "Bash(Write-Host:*)",
      "Bash(Write-Output:*)",
      "Bash(Start-Process:*)",
      "Bash(Stop-Process:*)",
      "Bash(Get-Process:*)",
      "Bash(Start-Sleep:*)",
      "Bash(Start-Job:*)",
      "Bash(ConvertFrom-Json:*)",
      "Bash(ConvertTo-Json:*)",
      "Bash(Compare-Object:*)",

      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(ln:*)",
      "Bash(mkdir:*)",
      "Bash(rmdir:*)",
      "Bash(touch:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(which:*)",
      "Bash(true:*)",
      "Bash(false:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",

      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",

      "Bash(godot:*)",
      "Bash(Godot_v4.6.2-stable_win64.exe:*)",

      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "MultiEdit(**)",
      "Glob(**)",
      "Grep(**)",

      "WebFetch(https://www.codebuddy.ai/**)",
      "WebFetch(https://copilot.tencent.com/**)",
      "WebFetch(https://staging-codebuddy.tencent.com/**)",
      "WebFetch(https://docs.godotengine.org/**)",
      "WebFetch(https://godotengine.org/**)",
      "WebFetch(https://api.timiai.woa.com/**)",
      "WebFetch(https://timiai.woa.com/**)",
      "WebFetch(https://iwiki.woa.com/**)",
      "WebSearch"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)"
    ],

    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(Remove-Item -Recurse -Force /:*)",
      "Read(./.timiai_key)",
      "Read(**/.timiai_key)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],

    "additionalDirectories": []
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/log-agent.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/detect-gaps.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
