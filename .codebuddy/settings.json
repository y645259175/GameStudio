{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python d:/AI/GameStudio/.codebuddy/hooks/session-start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python d:/AI/GameStudio/.codebuddy/hooks/user-prompt-route.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python d:/AI/GameStudio/.codebuddy/hooks/pre-tool-bash.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
